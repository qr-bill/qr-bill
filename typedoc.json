{
  "$schema": "https://typedoc.org/schema.json",
  "name": "qr-bill",
  "entryPoints": ["packages/core", "packages/pdfkit", "packages/invoice"],
  "entryPointStrategy": "packages",
  "packageOptions": {
    "entryPoints": ["src"],
    "entryPointStrategy": "expand",
    "readme": "none",
    "sort": ["source-order"]
  },
  "out": "docs/api",
  "plugin": ["./scripts/typedoc-link-by-name.js"],
  "readme": "none",
  "validation": {
    "notExported": true,
    "invalidLink": true,
    "rewrittenLink": true,
    "notDocumented": true
  },
  "treatWarningsAsErrors": true
}
