{
  "name": "qr-bill-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.13",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --recursive build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm --recursive typecheck",
    "docs:build": "typedoc",
    "docs:watch": "typedoc --watch",
    "check:docs": "typedoc --emit none",
    "check:package": "pnpm --recursive check:package",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.10.0",
    "publint": "^0.3.25",
    "rolldown": "^1.3.2",
    "tsdown": "^0.23.7",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
