{
  // Type-checks tests and tooling files. Library sources are checked by each
  // package's own tsconfig, which has no Node or DOM types on purpose.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "isolatedDeclarations": false,
    "declaration": false,
    "types": ["node"],
    // The tests of the adapters run against the sources of the core, so that no build is needed first.
    "paths": {
      "@qr-bill/core": ["./packages/core/src/index.ts"],
      "@qr-bill/pdfkit": ["./packages/pdfkit/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "*.config.ts", "packages/*/*.config.ts"],
  // Third-party code kept unmodified as a test reference: not ours to type-check.
  "exclude": ["packages/*/test/**/reference/**"]
}
