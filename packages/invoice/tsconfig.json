{
  // Type-checks the invoice against the sources of the core and of the PDFKit adapter, so that no build is needed
  // first. The PDF is written on Node, like the adapter, which reads its fonts from its package.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "noEmit": true,
    "paths": {
      "@qr-bill/core": ["../core/src/index.ts"],
      "@qr-bill/pdfkit": ["../pdfkit/src/index.ts"]
    }
  },
  "include": ["src"]
}
